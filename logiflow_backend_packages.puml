@startuml LogiFlow_Backend_Packages
title LogiFlow - Diagramme de Packages Backend

skinparam packageStyle rectangle
skinparam ArrowColor #444444
skinparam PackageBorderColor #1890ff
skinparam PackageBackgroundColor #f5f5f5
skinparam ComponentBackgroundColor #ffffff
skinparam ComponentBorderColor #91caff
skinparam defaultFontSize 11
skinparam linetype ortho

' ═══════════════════════════════════════════════════
'  INFRASTRUCTURE TRANSVERSALE
' ═══════════════════════════════════════════════════

package "src/auth/" #FFE7BA {
  [auth/auth.module.ts]
  [auth/auth.controller.ts]
  [auth/auth.service.ts]
  [auth/jwt.strategy.ts]
}

package "src/common/" #FFE7BA {
  package "src/common/enums/" {
    [common/enums/role.enum.ts]
    [common/enums/bl-status.enum.ts]
    [common/enums/company-type.enum.ts]
  }
  package "src/common/decorators/" {
    [common/decorators/roles.decorator.ts]
    [common/decorators/current-user.decorator.ts]
  }
  package "src/common/guards/" {
    [common/guards/jwt-auth.guard.ts]
    [common/guards/roles.guard.ts]
  }
}

package "src/mail/" #FFE7BA {
  [mail/mail.module.ts]
  [mail/mail.service.ts]
}

' ═══════════════════════════════════════════════════
'  GESTION DES SOCIÉTÉS & UTILISATEURS
