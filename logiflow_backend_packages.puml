database "PostgreSQL" #E9D8FD {
  [TypeORM Repository<Entity>] as TypeORMRepo
}

' ═══════════════════════════════════════════════════
'  DÉPENDANCES
' ═══════════════════════════════════════════════════

[auth/jwt.strategy.ts]               --> [common/enums/role.enum.ts]          : utilise
[auth/auth.service.ts]               --> [common/guards/jwt-auth.guard.ts]    : protège
[common/guards/roles.guard.ts]       --> [common/enums/role.enum.ts]          : vérifie

[invitations/invitations.service.ts] --> [mail/mail.service.ts]               : envoie credentials

[loading-plans/loading-plans.service.ts] --> [bons-livraison/bons-livraison.service.ts] : assigne BL
[loading-plans/loading-plans.service.ts] --> [quais/quais.service.ts]                   : affecte quai

[expediteur-portal/expediteur-portal.service.ts] --> [expediteurs/expediteurs.service.ts] : délègue

[companies/companies.service.ts]      --> TypeORMRepo : accède
[users/users.service.ts]              --> TypeORMRepo : accède
[invitations/invitations.service.ts]  --> TypeORMRepo : accède
[loading-plans/loading-plans.service.ts] --> TypeORMRepo : accède
[bons-livraison/bons-livraison.service.ts] --> TypeORMRepo : accède
[trucks/trucks.service.ts]            --> TypeORMRepo : accède
[expediteurs/expediteurs.service.ts]  --> TypeORMRepo : accède

@enduml
