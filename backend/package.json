{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:transport-admin": "ts-node -r tsconfig-paths/register src/seed-transport-admin.ts",
    "seed:rb": "ts-node -r tsconfig-paths/register src/seed-rose-blanche.ts",
    "seed:planning": "ts-node -r tsconfig-paths/register src/seed-planning.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/seed-bls-demo.ts",
    "seed:magasinier": "ts-node -r tsconfig-paths/register src/seed-magasinier.ts",
    "seed:quai": "ts-node -r tsconfig-paths/register src/seed-quai.ts",
    "seed:securite": "ts-node -r tsconfig-paths/register src/seed-securite.ts",
    "seed:pb": "ts-node -r tsconfig-paths/register src/seed-pate-blanche.ts",
    "seed:full": "ts-node -r tsconfig-paths/register src/seed-full.ts",
    "seed:quais": "ts-node -r tsconfig-paths/register src/seed-quais-test.ts",
    "seed:expediteur": "ts-node -r tsconfig-paths/register src/seed-expediteur.ts",
    "seed:demo-full": "ts-node -r tsconfig-paths/register src/seed-demo-complet.ts",
    "seed:rb-complet": "ts-node -r tsconfig-paths/register src/seed-rb-complet.ts",
    "seed:plan-quai": "ts-node -r tsconfig-paths/register src/seed-plan-quai.ts",
    "seed:gestion-quais": "ts-node -r tsconfig-paths/register src/seed-gestion-quais.ts",
    "seed:controle-entrees": "ts-node -r tsconfig-paths/register src/seed-controle-entrees.ts",
    "seed:main": "ts-node -r tsconfig-paths/register src/seed-main.ts",
    "seed:camions": "ts-node -r tsconfig-paths/register src/seed-camions-complet.ts",
    "seed:bls-logistique": "ts-node -r tsconfig-paths/register src/seed-bls-logistique.ts",
    "seed:mag1-volume": "ts-node -r tsconfig-paths/register src/seed-mag1-volume.ts",
    "seed:volume": "ts-node -r tsconfig-paths/register src/seed-volume.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.19",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "handlebars": "^4.7.9",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
